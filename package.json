{
  "name": "rig-agent-harness",
  "version": "0.1.1",
  "description": "A terminal-native AI harness for autonomous agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AyushNimbhare/rig.git"
  },
  "homepage": "https://github.com/AyushNimbhare/rig#readme",
  "bugs": {
    "url": "https://github.com/AyushNimbhare/rig/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rig": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "terminal",
    "coding-agent",
    "autonomous",
    "harness",
    "openai",
    "openrouter"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup src/index.ts src/cli/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
